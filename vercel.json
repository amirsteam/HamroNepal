{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 60, "includeFiles": "apps/web/dist/index.html" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/news/:slug", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/news-sitemap.xml", "destination": "/api" },
    { "source": "/rss.xml", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
