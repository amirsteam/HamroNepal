{
  "name": "@hamronepal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "tsx --env-file-if-exists=.env src/ingest/cli.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "user:set": "tsx --env-file-if-exists=.env scripts/set-user.ts",
    "images:backfill": "tsx --env-file-if-exists=.env scripts/backfill-images.ts",
    "print:issue": "tsx --env-file-if-exists=.env scripts/print-issue.ts",
    "translate": "tsx --env-file-if-exists=.env scripts/translate.ts"
  },
  "dependencies": {
    "@hamronepal/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "25.14.0",
    "qrcode": "1.5.4",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
