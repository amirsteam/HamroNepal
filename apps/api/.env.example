# --- Required ---
# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hamronepal
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Site ---
PORT=4000
PUBLIC_SITE_URL=http://localhost:5173
# Extra origins allowed to call the API with cookies (comma separated). Same-origin needs nothing.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Images (Cloudinary free tier) ---
# Either the URL (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) or the three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (server side only, never exposed to the browser) ---
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (free tier, fallback): https://console.groq.com/keys
GROQ_API_KEY=
AI_PRIMARY_MODEL=gemini-flash-lite-latest
AI_FALLBACK_MODEL=openai/gpt-oss-120b
# Minimum gap between AI calls per provider (ms). 4000 = 15 requests/minute.
AI_MIN_INTERVAL_MS=4000

# --- Stock photos for AI drafts (free): https://www.pexels.com/api/ ---
# Empty = AI drafts use the topic's default image (or the site placeholder).
PEXELS_API_KEY=

# --- AI news ingestion ---
INGEST_MAX_DRAFTS=10
INGEST_MAX_PER_CATEGORY=3
INGEST_MIN_CONFIDENCE=0.6
INGEST_MAX_AGE_HOURS=24

# --- Weather (OpenWeatherMap, proxied so the key stays private) ---
OPENWEATHER_API_KEY=
WEATHER_LAT=27.5846
WEATHER_LON=85.5147
WEATHER_LABEL=पनौती
