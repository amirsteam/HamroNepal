# --- Required ---
# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hamronepal
# Only if your DNS cannot look up the mongodb+srv host ("querySrv ECONNREFUSED"):
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Site ---
PORT=4000
PUBLIC_SITE_URL=http://localhost:5173
# Extra origins allowed to call the API with cookies (comma separated). Same-origin needs nothing.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Images (Cloudinary free tier) ---
# Either the URL (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) or the three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (server side only, never exposed to the browser) ---
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (free tier, fallback): https://console.groq.com/keys
GROQ_API_KEY=
AI_PRIMARY_MODEL=gemini-flash-lite-latest
AI_FALLBACK_MODEL=openai/gpt-oss-120b
# Minimum gap between AI calls per provider (ms). 4000 = 15 requests/minute.
AI_MIN_INTERVAL_MS=4000

# --- Stock photos for AI drafts (free): https://www.pexels.com/api/ ---
# Empty = AI drafts use the topic's default image (or the site placeholder).
PEXELS_API_KEY=

# --- AI news ingestion ---
INGEST_MAX_DRAFTS=10
INGEST_MAX_PER_CATEGORY=3
INGEST_MIN_CONFIDENCE=0.6
INGEST_MAX_AGE_HOURS=24
# Link the source outlet's own photo instead of a Pexels stock photo.
# The photos belong to the outlets: only for demos or with their permission.
INGEST_SOURCE_IMAGES=false
# "अहिले समाचार ल्याउनुहोस्" on AI समीक्षा starts the GitHub news job with this
# token (fine-grained, this repo only, "Actions: read and write"). Without it
# the button runs a small batch in the request instead.
# GITHUB_DISPATCH_TOKEN=github_pat_...
# GITHUB_REPO=owner/HamroNepal   (Vercel fills this itself)

# --- Print edition (npm run print:issue; weekly job .github/workflows/print.yml) ---
# Masthead details. Name/tagline/frequency default to हाम्रो नेपाल / साप्ताहिक.
# PRINT_REG_NO=जि.प्र.का. द. नं. ...
# PRINT_PRICE=५
# PRINT_EMAIL=letters@example.com
# PRINT_PAGES=6
# First issue date (YYYY-MM-DD): "वर्ष" counts from it.
# PRINT_FIRST_ISSUE_DATE=2026-11-06
# Continue an existing paper's numbering (next अंक = offset + 1).
# PRINT_ISSUE_OFFSET=0
# Chrome/Edge executable; found automatically when empty.
# CHROME_PATH=
# Ghostscript (makes the PDF CMYK); found automatically when empty.
# GS_PATH=
# CMYK profile for photos if the press gives one (e.g. a newsprint .icc file).
# PRINT_ICC_PROFILE=

# --- Weather (OpenWeatherMap, proxied so the key stays private) ---
OPENWEATHER_API_KEY=
WEATHER_LAT=27.5846
WEATHER_LON=85.5147
WEATHER_LABEL=पनौती
