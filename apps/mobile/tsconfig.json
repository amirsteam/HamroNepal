{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@hamronepal/shared": [
        "../../packages/shared/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
